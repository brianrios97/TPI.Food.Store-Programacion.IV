# Conexión a la base de datos (PostgreSQL o SQLite para desarrollo)
DATABASE_URL=sqlite:///./foodstore.db
# Para PostgreSQL: postgresql://user:password@localhost:5432/foodstore_db

# Clave secreta para firma de tokens JWT (mínimo 32 caracteres)
SECRET_KEY=clave-super-secreta-para-firmar-jwt-foodstore-2026-utn

# Algoritmo de firma
ALGORITHM=HS256

# Tiempo de expiración del token y la cookie (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen permitido para CORS (puerto del frontend Vite)
FRONTEND_ORIGIN=http://localhost:5173

